service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == "hoangnhan99vt@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidCharacter(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 30 &&
             data.realm is int && data.realm >= 1 && data.realm <= 20;
    }

    match /characters/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidCharacter(request.resource.data);
      allow update: if isOwner(userId) && isValidCharacter(request.resource.data);
    }

    match /world/state {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/api_keys {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
